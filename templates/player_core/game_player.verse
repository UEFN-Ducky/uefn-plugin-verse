# SETUP: Per-player object. Services starts with SaveService only.
# Feature packs hold their own [agent]manager maps — they do not edit this file.
using { /Verse.org/Simulation }
using { /Fortnite.com/Devices }
using { /Fortnite.com/Characters }

game_player_services <public> := struct():
    SaveService <public> : save_service = save_service{}

game_player <public> := class<unique>():
    MyAgent <public> : agent
    var MyFortChar : ?fort_character = false
    Services <public> : game_player_services = game_player_services{}

    Init(Agent : agent) : void =
        set MyFortChar = option{Agent.GetFortCharacter[]}
        Services.SaveService.InitializePlayer(option{Agent})

    GetAgent<public>()<transacts> : agent = MyAgent
    GetFortCharacter<public>()<transacts> : ?fort_character = MyFortChar
