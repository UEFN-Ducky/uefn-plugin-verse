      {
        "id": "tycoon",
        "name": "Tycoon Core",
        "icon": "\ud83c\udfed",
        "description": "building_unlock_manager + generator_manager. Pays via Economy; offline via Time Tracker.",
        "folder": "Tycoon",
        "connects": [
          "consumes:currency_provider",
          "consumes:playtime_provider",
          "needs:PlayerCore"
        ],
        "files": [
          {
            "path": "building_unlock_manager.verse",
            "file": "templates/tycoon/building_unlock_manager.verse"
          },
          {
            "path": "generator_manager.verse",
            "file": "templates/tycoon/generator_manager.verse"
          }
        ],
        "order": 70
      },
      {
        "id": "umg_widget",
        "name": "UMG Widget Device",
        "icon": "\ud83d\uddb1\ufe0f",
        "description": "event_subscription helpers + creative_device skeleton for driving a UW_* User Widget (Verse fields / field events). Uncomment SETUP lines after the widget exists in Assets digest.",
        "folder": "UMGWidget",
        "files": [
          {
            "path": "widget_event_helpers.verse",
            "file": "templates/umg-widget/widget_event_helpers.verse"
          },
          {
            "path": "umg_widget_device.verse",
            "file": "templates/umg-widget/umg_widget_device.verse"
          }
