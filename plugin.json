    "walkthrough": {
      "id": "verse",
      "title": "Verse tools ready",
      "auto_start": "first_enable",
      "settings_tab": "Store",
      "steps": [
        {
          "target": "settings.store.root",
          "title": "Verse tools ready",
          "body": "Verse digests, wiring, compile/errors, and template tools are live. Ask for digests, wire devices, or apply templates.",
          "advance": "next",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
