            "path": "currency_exchange_controller.verse",
            "file": "templates/shop/currency_exchange_controller.verse"
          }
        ],
        "order": 50
      },
      {
        "id": "match_timer",
        "name": "Match Timer",
        "icon": "\u23f2\ufe0f",
        "description": "Countdown/count-up controller + swappable timer_canvas builder.",
        "folder": "MatchTimer",
        "connects": [
          "needs:PlayerCore"
        ],
        "files": [
          {
            "path": "timer_canvas_builder.verse",
            "file": "templates/match_timer/timer_canvas_builder.verse"
          },
          {
            "path": "match_timer_controller.verse",
            "file": "templates/match_timer/match_timer_controller.verse"
          }
        ],
        "order": 60
