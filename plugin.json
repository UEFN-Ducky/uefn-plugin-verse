        "files": [
          {
            "path": "progression_manager.verse",
            "file": "templates/progression/progression_manager.verse"
          },
          {
            "path": "progression_canvas_builder.verse",
            "file": "templates/progression/progression_canvas_builder.verse"
          },
          {
            "path": "progression_manager_device.verse",
            "file": "templates/progression/progression_manager_device.verse"
          }
        ],
        "order": 30
      },
      {
        "id": "time_tracker",
        "name": "Time Tracker",
        "icon": "\u23f1\ufe0f",
        "description": "Session / playtime + offline seconds. Registers playtime_provider.",
        "folder": "TimeTracker",
        "connects": [
          "registers:playtime_provider",
          "needs:PlayerCore"
        ],
        "files": [
          {
            "path": "player_time_tracker.verse",
            "file": "templates/time_tracker/player_time_tracker.verse"
          },
          {
            "path": "time_tracker_device.verse",
            "file": "templates/time_tracker/time_tracker_device.verse"
